# =====================================================
# DOCKER ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env.docker and update the values
# cp .env.docker.example .env.docker

# =====================================================
# PostgreSQL Database Configuration
# =====================================================
POSTGRES_DB=elearning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Database URL (constructed automatically in docker-compose)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/elearning?schema=public

# =====================================================
# Application Configuration
# =====================================================
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================
# Supabase Configuration (if using Supabase)
# =====================================================
# If you're using Supabase for auth, keep these
# Otherwise, you'll use local PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =====================================================
# Cloudinary Configuration
# =====================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# =====================================================
# Stripe Configuration (Optional - for payment gateway)
# =====================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =====================================================
# pgAdmin Configuration (Optional - for database management)
# =====================================================
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =====================================================
# Security & Sessions
# =====================================================
# Generate a secure random string for JWT secret
JWT_SECRET=your_jwt_secret_min_32_characters
SESSION_SECRET=your_session_secret_min_32_characters

# =====================================================
# Email Configuration (Optional - for notifications)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourdomain.com
