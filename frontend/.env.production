# Production Environment Variables for Frontend
# DO NOT commit actual values to Git - set these in Netlify UI

# Backend API URL - Replace with your actual backend URL after deploying to Render
VITE_API_URL=https://your-backend-app.onrender.com/api

# Stripe Publishable Key - Use your production key
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_publishable_key
