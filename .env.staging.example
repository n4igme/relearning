# ===============================================
# STAGING ENVIRONMENT VARIABLES (Local Docker)
# ===============================================
# Copy this file to .env.docker for staging deployment
# Use: docker-compose -f docker-compose.staging.yml up -d

# Local PostgreSQL Database (runs in Docker)
POSTGRES_DB=elearning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# Supabase (Can use cloud Supabase or local PostgreSQL)
# Option 1: Use cloud Supabase for auth and database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Option 2: Use local PostgreSQL (comment out Supabase URLs above)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/elearning

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Stripe (Optional - use test keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# pgAdmin (Optional - for database management UI)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
