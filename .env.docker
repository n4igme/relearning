# Docker Environment Configuration
# Copy this file to .env and update with your values

# Application
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_secure_password
MONGODB_URI=mongodb://admin:changeme_secure_password@mongodb:27017/elearning?authSource=admin

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Mongo Express (Optional - for database management UI)
MONGOEXPRESS_LOGIN=admin
MONGOEXPRESS_PASSWORD=secure_password
