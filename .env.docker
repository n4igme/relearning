# Docker Environment Configuration
# Copy this file to .env and update with your values

# Application
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme_secure_password
MONGODB_URI=mongodb://admin:changeme_secure_password@mongodb:27017/elearning?authSource=admin

# JWT Configuration
JWT_SECRET=simple_jwt_secret_for_dev
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=simple_refresh_secret_for_dev
JWT_REFRESH_EXPIRE=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=eLearning Platform
FROM_EMAIL=your_email@gmail.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Midtrans Configuration (Backup Payment Gateway)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SANDBOX=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=video/mp4,video/avi,video/mov,application/pdf,text/plain,text/html
UPLOAD_PATH=uploads/

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=10
PASSING_SCORE=70

# Mongo Express (Optional - for database management UI)
MONGOEXPRESS_LOGIN=admin
MONGOEXPRESS_PASSWORD=secure_password
